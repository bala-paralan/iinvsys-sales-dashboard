# ── Application ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ─────────────────────────────────────────────────────────
# Local:    mongodb://localhost:27017/iinvsys
# Atlas:    mongodb+srv://<user>:<pass>@cluster.mongodb.net/iinvsys
MONGO_URI=mongodb://localhost:27017/iinvsys
# Note: MONGODB_URI is also accepted (used by some PaaS like Railway/Render)

# ── Docker Compose only (backend/docker-compose.yml) ────────────────
# REQUIRED — the stack refuses to start without these. Mongo runs with
# --auth and is never published to the host; see the security note in
# docker-compose.yml. Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MONGO_ROOT_USER=iinvsys_admin
MONGO_ROOT_PASS=replace_with_a_long_random_string

# ── JWT ─────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
JWT_SECRET=replace_with_a_64_char_random_string
JWT_EXPIRES_IN=7d

# ── First-run superadmin ────────────────────────────────────────────
# initAdmin creates this account only when the users collection is empty.
# In production ADMIN_PASSWORD is REQUIRED — boot fails without it, rather
# than falling back to a shared default. Outside production a random
# password is generated and printed to stdout once.
ADMIN_EMAIL=admin@iinvsys.com
# ADMIN_PASSWORD=

# ── Uploaded documents ──────────────────────────────────────────────
# gridfs (default) stores files in Mongo over the existing connection, so it
# behaves identically on Vercel and on-prem. `local` writes to UPLOAD_DIR and is
# REFUSED on Vercel, where the filesystem is ephemeral (assumption A25).
# FILE_STORE_DRIVER=gridfs
# UPLOAD_DIR=./uploads
# UPLOAD_MAX_BYTES=15728640

# ── Business-day SLAs ───────────────────────────────────────────────
# Comma-separated ISO dates excluded from business-day arithmetic, alongside
# weekends. Unset means weekends only.
# HOLIDAYS=2026-01-26,2026-08-15,2026-10-02
# TZ_BUSINESS=Asia/Kolkata

# ── Rate Limiting ───────────────────────────────────────────────────
# (optional overrides — defaults shown)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200
# AUTH_RATE_LIMIT_MAX applies to FAILED logins only (successful ones are
# not counted), so a low ceiling is safe.
# AUTH_RATE_LIMIT_MAX=5

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave blank to allow all in dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:3456

# ── Email ────────────────────────────────────────────────────────────
# OPTION A — Resend (recommended for Vercel / cloud; free tier: 3k emails/month)
#   1. Sign up at https://resend.com
#   2. Create an API key
#   3. Set RESEND_API_KEY — SMTP_* vars are ignored when this is present
#
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="IINVSYS Reports <you@yourdomain.com>"
#
# OPTION B — SMTP (for on-premise / Docker only; does NOT work on Vercel)
# ── SMTP ─────────────────────────────────────────────────────────────
# Works with any SMTP provider (Gmail, SendGrid, Mailgun, self-hosted, etc.)
#
# Gmail example (use an App Password, not your account password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="IINVSYS Reports <you@gmail.com>"
#
# SendGrid example:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=SG.your-sendgrid-api-key
#   SMTP_FROM="IINVSYS Reports <noreply@yourdomain.com>"
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="IINVSYS Reports <your-email@gmail.com>"
